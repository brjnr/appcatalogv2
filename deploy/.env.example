# Docker Compose environment for AppCatalog — copy to deploy/.env and fill in.
# MONGO_URL is set by compose (service "mongo"); do not put it here.

# Hostname or IP users type in the browser. Used for the Host allowlist.
PUBLIC_HOST=apps.example.com
TRUSTED_HOSTS=apps.example.com

# Port published on the host for the web container.
HTTP_PORT=80

DB_NAME=appcatalog_prod

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_KEY=

# Frontend and API share one origin through nginx, so leave this empty.
CORS_ORIGINS=

# 1 when reachable over HTTPS, 0 for a plain-HTTP lab.
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=lax

MAX_REQUEST_BYTES=3145728
LOG_LEVEL=INFO
