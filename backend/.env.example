# AppCatalog backend configuration — copy to backend/.env and fill in per environment.
# Never commit the real .env; production values must be provisioned by the deployment.

# MongoDB — required. Rotate on any suspected exposure.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="appcatalog"

# Exact origin allowlist for browser cookie auth. Empty = same-origin only.
# NEVER combine "*" with credentials — server refuses to register CORS in that case.
CORS_ORIGINS=""

# Trusted Host header allowlist. Set to your ingress hostname(s) in production
# to block Host-header injection. "*" is a dev fallback only.
TRUSTED_HOSTS="*"

# Session cookie hardening. Turn SECURE on for any deployment reachable over HTTPS.
SESSION_COOKIE_SECURE="1"
SESSION_COOKIE_SAMESITE="lax"

# Reject request bodies larger than this many bytes (3 MB by default).
MAX_REQUEST_BYTES="3145728"

# Optional runtime knobs.
LOG_LEVEL="INFO"

# Symmetric key (URL-safe base64, 32 bytes) used to encrypt integration secrets
# in the ``integrations`` collection. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty a key is derived from SECRET_KEY / DB_NAME (dev only — set a real
# key in production so rotating SECRET_KEY does not invalidate stored secrets).
INTEGRATIONS_KEY=""
