# AppCatalog — repository ignores
# Rule of thumb: source and config are tracked; anything generated, machine-local,
# or agent/runtime metadata is not.

# --- Dependencies / build output ---
node_modules/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
dist/
build/
*.tsbuildinfo
/coverage
.cache/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Secrets & environment ---
.env
.env.*
*.env
!.env.example
!*.env.example
!**/.env.example
*.pem
*.key
credentials.json
*credentials.json*
*token.json*
.credentials

# --- Runtime / user data (not product source) ---
backend/uploads/
dump.rdb

# --- Generated test output & reports ---
/test_reports/
/test_result.md
tests/test-results/
tests/playwright-report/
*.xml.orig

# --- Agent / platform runtime metadata (kept on disk, never committed) ---
/memory/
**/.emergent/recordings/
.ac
.chainlit
chainlit.md

# --- Repository root is NOT a yarn workspace; the stub lockfile is pod-local ---
/yarn.lock

# --- Retired starter scaffolding (deleted 2026-06; never reintroduce) ---
/backend-starter-backup/
/frontend-starter-backup/
/archive/

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Archives & large binaries ---
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
*.pack
*.deb
*.dylib
